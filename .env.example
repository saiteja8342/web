# ==============================================================================
# Supabase Configuration
# ==============================================================================

# Public Client Configuration (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Vite synonyms (automatically mapped for full compatibility)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Server-Side / Secure Configuration (NEVER expose to the browser / client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
