{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard/admin", "destination": "/dashboard/admin/index.html" },
    { "source": "/dashboard/admin/:path*", "destination": "/dashboard/admin/index.html" },
    { "source": "/dashboard/editor", "destination": "/dashboard/editor/index.html" },
    { "source": "/dashboard/editor/:path*", "destination": "/dashboard/editor/index.html" },
    { "source": "/dashboard/client", "destination": "/dashboard/client/index.html" },
    { "source": "/dashboard/client/:path*", "destination": "/dashboard/client/index.html" },
    { "source": "/admin/login", "destination": "/admin/login/index.html" },
    { "source": "/admin/login/:path*", "destination": "/admin/login/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/work", "destination": "/work.html" },
    { "source": "/our-work", "destination": "/our-work.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/client", "destination": "/client.html" },
    { "source": "/editor", "destination": "/editor.html" }
  ]
}
